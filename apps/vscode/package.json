{
  "name": "weights-viz",
  "displayName": "Weights Viz",
  "description": "Inspect GGUF, SafeTensors, and ONNX model weight layouts.",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "publisher": "justinchuby",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justinchuby/weights-viz.git"
  },
  "homepage": "https://github.com/justinchuby/weights-viz#readme",
  "bugs": {
    "url": "https://github.com/justinchuby/weights-viz/issues"
  },
  "keywords": [
    "gguf",
    "safetensors",
    "onnx",
    "machine-learning",
    "visualization"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Visualization"],
  "activationEvents": [
    "onCustomEditor:weightsViz.viewer",
    "onCommand:weightsViz.openUrl",
    "onCommand:weightsViz.openFiles",
    "onCommand:weightsViz.visualize"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "customEditors": [
      {
        "viewType": "weightsViz.viewer",
        "displayName": "Weights Visualization",
        "selector": [
          { "filenamePattern": "*.gguf" },
          { "filenamePattern": "*.safetensors" },
          { "filenamePattern": "*.onnx" },
          { "filenamePattern": "*.safetensors.index.json" }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "weightsViz.openFiles",
        "title": "Weights Viz: Open Model Files"
      },
      {
        "command": "weightsViz.openUrl",
        "title": "Weights Viz: Open Model URL"
      },
      {
        "command": "weightsViz.visualize",
        "title": "Visualize Weights"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "weightsViz.visualize",
          "when": "resourceExtname == .gguf || resourceExtname == .safetensors || resourceExtname == .onnx || resourceFilename =~ /\\.safetensors\\.index\\.json$/ || resourceLangId == textproto",
          "group": "navigation@10"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:webview && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.cjs",
    "build:webview": "vite build",
    "package": "pnpm run build && vsce package --no-dependencies --out dist/weights-viz.vsix",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@weights-viz/core": "workspace:*",
    "@weights-viz/ui": "workspace:*",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.9"
  }
}
